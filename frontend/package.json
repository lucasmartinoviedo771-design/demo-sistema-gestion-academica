{
	"name": "ipes6-frontend-clean",
	"private": true,
	"version": "0.0.0",
	"packageManager": "pnpm@10.33.0",
	"scripts": {
		"start": "vite",
		"dev": "vite --host",
		"build": "tsc -b && vite build && node scripts/precompress.cjs",
		"preview": "vite preview",
		"lint": "eslint src/ vite.config.ts --report-unused-disable-directives --max-warnings 0",
		"test": "vitest run"
	},
